# Add the mobile hostname to your existing HTTPS vhost and certificate.
# This example assumes a certificate covering BOTH hostnames.
server {
    listen 443 ssl;
    server_name invidious.wingress.net mobivious.wingress.net;
    ssl_certificate /etc/letsencrypt/live/invidious.wingress.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/invidious.wingress.net/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }
}
