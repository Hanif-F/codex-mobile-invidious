<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@color/exo_black_opacity_60,@color/exo_bottom_bar_background,@color/exo_black_opacity_70">
    <!-- Keep the picture clear; the native Media3 clip-preview footer uses a
         black player scrim and settings popups have an opaque dark surface. -->
    <color name="exo_black_opacity_60" tools:override="true">@android:color/transparent</color>
    <color name="exo_bottom_bar_background" tools:override="true">#B8000000</color>
    <color name="exo_black_opacity_70" tools:override="true">#1F2228</color>
</resources>
