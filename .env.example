# Copy existing values from the Ubuntu server. Never commit the real .env.
# Server checkout path, relative to docker-compose.yml or absolute.
INVIDIOUS_SOURCE_DIR=../invidious
# Keep the current database password: changing this variable does not change an existing DB user's password.
POSTGRES_PASSWORD=kemal
COMPANION_SECRET=replace_with_existing_companion_key
HMAC_KEY=replace_with_existing_hmac_key
DEARROW_IDENTITY_KEY=replace_with_existing_dearrow_identity_key
COMPANION_IMAGE=quay.io/invidious/invidious-companion:latest
# For accurate login throttling behind a host reverse proxy, use the actual Docker
# bridge gateway /32 from `docker network inspect invidious-codex-v3_default`.
AUTH_TRUSTED_PROXY_CIDR=127.0.0.1/32
